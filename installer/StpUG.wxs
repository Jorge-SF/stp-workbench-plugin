<?xml version="1.0" encoding="utf-8"?>
<!--
  The STP UG MSI (WiX 5). Built by tools\Build-Plugin.ps1, which passes:
    -d Version=x.y.z          -d PayloadDir=<staged payload folder>
  Payload layout (what the plugin expects, see src\StpClient\Bridge\StpScripts.cs):
    Client\StpClient.dll, StpEngine.dll, StpBridge.dll, StpPlanner.dll, StpTimeline.dll (+pdb)
    Client\Python\scripts\*.py      the entry scripts the STP UG menu runs inside Vulcan
    Client\Python\stp_core\*.py     the Python core they import
    Client\Python\web\*             the planner's HTML/JS (reference/web; + assets\Maptek_highres.jpg when the
                                    builder has installer\private\Maptek_highres.jpg, never committed)
    VERSION.txt
  Everything the scripts write goes to the user's own %LOCALAPPDATA%\Maptek\StpUG\runtime (KI-2, fixed), so
  the install folder stays read-only for Users.
  Installs to C:\Program Files\Maptek\STP UG and registers its Client folder under
  HKLM\SOFTWARE\Maptek\Workbench\Client\PluginSearchPaths as 'StpUG'. Uninstall removes only that value,
  never the key or other products' values. A newer version replaces an older one (MajorUpgrade).
  NEVER change the UpgradeCode.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="STP UG" Manufacturer="Maptek" Version="$(Version)"
           UpgradeCode="76829F4F-71DC-466D-B95F-F157CC4C6035" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of STP UG is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="Stp.ico" SourceFile="..\src\StpClient\Resources\Icons\Stp.ico" />
    <Property Id="ARPPRODUCTICON" Value="Stp.ico" />
    <Property Id="ARPCOMMENTS" Value="Short Term Planner for the Vulcan Gantt Scheduler (Workbench plugin)" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="MaptekFolder" Name="Maptek">
        <Directory Id="INSTALLFOLDER" Name="STP UG">
          <Directory Id="ClientFolder" Name="Client" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="STP UG">
      <!-- The payload holds only tracked files (Build-Plugin.ps1 copies them from git ls-files): no __pycache__. -->
      <Files Directory="INSTALLFOLDER" Include="$(PayloadDir)\**" />

      <Component Id="PluginSearchPath" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Maptek\Workbench\Client\PluginSearchPaths"
                       Name="StpUG" Type="string" Value="[ClientFolder]" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
