<?xml version="1.0" encoding="utf-8"?>
<!-- Edit VersionDigitMajor / VersionDigitMinor here. The build regenerates Properties\AssemblyVersionInfo.g.cs from these. -->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
 <Import Project="SolutionBuildNumberGenerated.props" Condition="exists('SolutionBuildNumberGenerated.props')" />
 <PropertyGroup>
   <VersionDigitMajor Condition="'$(VersionDigitMajor)' == ''">1</VersionDigitMajor>
   <VersionDigitMinor Condition="'$(VersionDigitMinor)' == ''">0</VersionDigitMinor>
   <VersionLabel Condition="'$(VersionLabel)' == ''">$(VersionDigitMajor).$(VersionDigitMinor)</VersionLabel>
   <VersionDigitRevision Condition="'$(VersionDigitRevision)' == ''">$(BuildVersionNumber)</VersionDigitRevision>
   <VersionDigitRevision Condition="'$(VersionDigitRevision)' == ''">0</VersionDigitRevision>
   <VersionDigitBuild Condition="'$(VersionDigitBuild)' == ''"></VersionDigitBuild>
   <AssemblyVersion>$(VersionDigitMajor).$(VersionDigitMinor)</AssemblyVersion>
   <VersionTwoDigits>$(AssemblyVersion)</VersionTwoDigits>
   <AssemblyVersion Condition="'$(VersionDigitRevision)' != ''">$(AssemblyVersion).$(VersionDigitRevision)</AssemblyVersion>
   <VersionThreeDigits>$(AssemblyVersion)</VersionThreeDigits>
   <AssemblyVersion Condition="'$(VersionDigitBuild)' != ''">$(AssemblyVersion).$(VersionDigitBuild)</AssemblyVersion>
   <VersionFourDigits>$(AssemblyVersion)</VersionFourDigits>
   <VersionDigitMajorOrZero>$(VersionDigitMajor)</VersionDigitMajorOrZero>
   <VersionDigitMinorOrZero>$(VersionDigitMinor)</VersionDigitMinorOrZero>
   <VersionDigitRevisionOrZero>$(VersionDigitRevision)</VersionDigitRevisionOrZero>
   <VersionDigitRevisionOrZero Condition="'$(VersionDigitRevisionOrZero)' == ''">0</VersionDigitRevisionOrZero>
   <VersionDigitBuildOrZero>$(VersionDigitBuild)</VersionDigitBuildOrZero>
   <VersionDigitBuildOrZero Condition="'$(VersionDigitBuildOrZero)' == ''">0</VersionDigitBuildOrZero>
   <GenerateVersionInfo>true</GenerateVersionInfo>
 </PropertyGroup>
</Project>
