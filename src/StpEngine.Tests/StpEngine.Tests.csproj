<Project Sdk="Microsoft.NET.Sdk">
  <!-- Engine tests. The main suite replays tools/golden/fixtures and compares with tools/golden/expected. -->
  <Import Project="..\..\WorkbenchRuntime.props" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Maptek.Vulcan.Stp.Engine.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\StpEngine\StpEngine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests read JSON fixtures; same Newtonsoft version the Workbench ships. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(WorkbenchRuntime)\SDK\Third\Newtonsoft.Json\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
