<?xml version="1.0" encoding="utf-8" ?>
<Segments xmlns="http://www.maptek.com/workbench/MenuSchema.xsd">
  <Alias Name="NS"  FullText="Maptek.Vulcan.Stp"/>
  <Alias Name="BIN" FullText="StpClient"/>   <!-- assembly name -->
  <Alias Name="RES" FullText="Resources"/>   <!-- Resources\Resources.resx -->

  <!-- STP UG > Preparar proyecto / Abrir planificador / Aplicar STP a VGS / Verificar guardado | Configuración y acerca de -->
  <Segment Name="[NS].Segments.StpMenu">
    <SegmentInstance MenuSegmentName="[NS].Segments.StpSteps"/>
    <SegmentInstance MenuSegmentName="[NS].Segments.StpSettings"/>
  </Segment>

  <Segment Name="[NS].Segments.StpSteps">
    <Command CommandName="[NS].Commands.Prepare"
             Label="{Key [BIN]:[RES]:Menu_Prepare}" ToolTip="{Key [BIN]:[RES]:Tip_Prepare}"
             Image="{Resource [BIN]:[RES]/Icons/Step1.ico}" SortOrder="10"/>
    <Command CommandName="[NS].Commands.PlannerView"
             Label="{Key [BIN]:[RES]:Menu_PlannerView}" ToolTip="{Key [BIN]:[RES]:Tip_PlannerView}"
             Image="{Resource [BIN]:[RES]/Icons/Step2.ico}" SortOrder="15"/>
    <Command CommandName="[NS].Commands.ApplyToVgs"
             Label="{Key [BIN]:[RES]:Menu_Apply}" ToolTip="{Key [BIN]:[RES]:Tip_Apply}"
             Image="{Resource [BIN]:[RES]/Icons/Step3.ico}" SortOrder="30"/>
    <Command CommandName="[NS].Commands.VerifySave"
             Label="{Key [BIN]:[RES]:Menu_Verify}" ToolTip="{Key [BIN]:[RES]:Tip_Verify}"
             Image="{Resource [BIN]:[RES]/Icons/Step4.ico}" SortOrder="40"/>
  </Segment>

  <Segment Name="[NS].Segments.StpSettings">
    <Command CommandName="[NS].Commands.Settings"
             Label="{Key [BIN]:[RES]:Menu_Settings}" ToolTip="{Key [BIN]:[RES]:Tip_Settings}"
             Image="{Resource [BIN]:[RES]/Icons/Stp.ico}"/>
  </Segment>

  <!-- 1) Vulcan (Envisage) menu bar, as its last menu (verified segment, Pit Design) -->
  <ExternalSegment Name="Maptek.Vulcan.Envisage.Segments.EnvisageMenus">
    <SubMenu MenuSegmentName="[NS].Segments.StpMenu" Label="{Key [BIN]:[RES]:Menu_Stp}"
             SortOrder="2147483646"/>
  </ExternalSegment>

  <!-- 2) STP UG toolbar in the Workbench main toolbar tray (markup from Maptek's ExampleApp template; whether it
       shows inside the Vulcan window is unverified, docs/envisage_python.md section 5) -->
  <Toolbar Name="[NS].Toolbars.StpToolbar" MenuSegmentName="[NS].Segments.StpMenu"
           Title="{Key [BIN]:[RES]:Toolbar_Title}"
           InitialTrayName="Maptek.Workbench.MainToolbar" GroupName="Maptek.Workbench.MainToolbarGroup"
           VisualizeForOwnerWhenAdded="true"/>
</Segments>
