<?xml version="1.0" encoding="utf-8" ?>
<Commands xmlns="http://www.maptek.com/workbench/ClientCommandSchema.xsd">
  <Alias Name="NS" FullText="Maptek.Vulcan.Stp"/>

  <!-- ExecuteCallback binds to a method on StpClientPlugin by name -->
  <Command Name="[NS].Commands.Prepare"     ExecuteCallback="{MethodBinding RunPrepare}"   Public="true"/>
  <Command Name="[NS].Commands.OpenPlanner" ExecuteCallback="{MethodBinding RunPlanner}"   Public="true"/>
  <Command Name="[NS].Commands.ApplyToVgs"  ExecuteCallback="{MethodBinding RunApply}"     Public="true"/>
  <Command Name="[NS].Commands.VerifySave"  ExecuteCallback="{MethodBinding RunVerify}"    Public="true"/>
  <Command Name="[NS].Commands.Settings"    ExecuteCallback="{MethodBinding ShowSettings}" Public="true"/>
</Commands>
