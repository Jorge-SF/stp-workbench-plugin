<!-- The planner document's content (docs/mockups/planner_layout.html). A plain UserControl bound to
     IPlannerViewModel, so it runs both inside the Workbench document (PlannerView.xaml) and in the standalone
     preview (tools/Preview-Planner.ps1). Labels come from Resources.resx through x:Static (works without the
     Workbench localizer). -->
<UserControl x:Class="Maptek.Vulcan.Stp.Views.Planner.PlannerContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Maptek.Vulcan.Stp.Resources"
             xmlns:p="clr-namespace:Maptek.Vulcan.Stp.Views.Planner"
             xmlns:t="clr-namespace:Maptek.Vulcan.Stp.Timeline;assembly=StpTimeline"
             FontFamily="Segoe UI" FontSize="12" Foreground="#1F2933" Background="#EEF0F3"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Line" Color="#D5D9E0"/>
    <SolidColorBrush x:Key="LineSoft" Color="#E8EBEF"/>
    <SolidColorBrush x:Key="Muted" Color="#66727F"/>
    <SolidColorBrush x:Key="Accent" Color="#0B5CAD"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E3EEFA"/>
    <SolidColorBrush x:Key="Weekend" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="Warn" Color="#B54708"/>
    <SolidColorBrush x:Key="Ok" Color="#127A3C"/>
    <SolidColorBrush x:Key="Strip" Color="#F8F9FB"/>
    <SolidColorBrush x:Key="Header" Color="#F3F5F8"/>

    <p:EmptyToVisibleConverter x:Key="EmptyToVisible"/>
    <p:PositiveConverter x:Key="Positive"/>
    <p:EmptyToNullConverter x:Key="EmptyToNull"/>
    <BooleanToVisibilityConverter x:Key="BoolToVisible"/>

    <!-- Command bar button: glyph (Tag) over the label (Content) -->
    <Style x:Key="BarButton" TargetType="Button">
      <Setter Property="Foreground" Value="#1F2933"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="MinWidth" Value="54"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="5,3">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe UI Symbol" FontSize="17" LineHeight="20"
                           HorizontalAlignment="Center"/>
                <ContentPresenter HorizontalAlignment="Center" TextBlock.TextAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#BCD4EF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#094D91"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="GroupLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style x:Key="Group" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
      <Setter Property="BorderThickness" Value="0,0,1,0"/>
      <Setter Property="Padding" Value="7,0"/>
    </Style>
    <Style x:Key="Kpi" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="6,1"/>
      <Setter Property="Margin" Value="2"/>
    </Style>
    <Style x:Key="KpiChanged" TargetType="Border" BasedOn="{StaticResource Kpi}">
      <Setter Property="TextBlock.Foreground" Value="#1F2933"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource Positive}}" Value="True">
          <Setter Property="BorderBrush" Value="#F1C58F"/>
          <Setter Property="Background" Value="#FFF7EC"/>
          <Setter Property="TextBlock.Foreground" Value="{StaticResource Warn}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="FilterLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>
    <!-- Type chip: a ToggleButton bound to ActivityTypeFilter.IsVisible -->
    <Style x:Key="Chip" TargetType="ToggleButton">
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="10" Padding="6,1">
              <StackPanel Orientation="Horizontal">
                <Border Width="8" Height="8" CornerRadius="2" Background="{Binding Color}" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding Name}"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#BCD4EF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="Background" Value="#EEF1F5"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="Margin" Value="0,1,2,1"/>
    </Style>
    <Style x:Key="SideHeader" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Header}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style x:Key="Key" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="0,2,8,2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Val" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <DataTemplate x:Key="PillTemplate">
      <Border Style="{StaticResource Pill}"><TextBlock Text="{Binding}"/></Border>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="WrapPanelTemplate"><WrapPanel/></ItemsPanelTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- command bar -->
      <RowDefinition Height="Auto"/>   <!-- filter strip -->
      <RowDefinition Height="*"/>      <!-- main -->
      <RowDefinition Height="Auto"/>   <!-- status bar -->
    </Grid.RowDefinitions>

    <!-- 1. Command bar ========================================================================================== -->
    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
            Padding="8,6">
      <DockPanel LastChildFill="False">
        <!-- Datos -->
        <Border Style="{StaticResource Group}" DockPanel.Dock="Left">
          <DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupLabel}" Text="{x:Static res:Resources.Planner_GroupData}"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource BarButton}" Tag="&#x21BB;" Command="{Binding RefreshCommand}"
                      Content="{x:Static res:Resources.Planner_Refresh}" ToolTip="{x:Static res:Resources.Planner_RefreshTip}"/>
              <Border x:Name="LiveIndicator" CornerRadius="10" Padding="8,2" Margin="4,0" VerticalAlignment="Center"
                      ToolTip="{Binding ConnectionTip, Converter={StaticResource EmptyToNull}}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="LiveDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                           Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                  <TextBlock Text="{Binding ConnectionText}" FontWeight="SemiBold"/>
                </StackPanel>
                <Border.Style>
                  <!-- Colours as setters, not local values: a local value would win over the "not live" trigger. -->
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="#E7F5EC"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource Ok}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsLive}" Value="False">
                        <Setter Property="Background" Value="#F3F5F8"/>
                        <Setter Property="TextBlock.Foreground" Value="{StaticResource Muted}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
              </Border>
            </StackPanel>
          </DockPanel>
        </Border>
        <!-- Plan -->
        <Border Style="{StaticResource Group}" DockPanel.Dock="Left">
          <DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupLabel}" Text="{x:Static res:Resources.Planner_GroupPlan}"/>
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource BarButton}" Tag="&#x21B6;" Command="{Binding UndoCommand}" Content="{x:Static res:Resources.Planner_Undo}"
                      ToolTip="{Binding UndoTip}"/>
              <Button Style="{StaticResource BarButton}" Tag="&#x21B7;" Command="{Binding RedoCommand}" Content="{x:Static res:Resources.Planner_Redo}"
                      ToolTip="{Binding RedoTip}"/>
              <Button Style="{StaticResource BarButton}" Tag="&#x2715;" Command="{Binding DiscardCommand}" Content="{x:Static res:Resources.Planner_Discard}"
                      ToolTip="{x:Static res:Resources.Planner_DiscardTip}"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <!-- VGS -->
        <Border Style="{StaticResource Group}" DockPanel.Dock="Left">
          <DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupLabel}" Text="{x:Static res:Resources.Planner_GroupVgs}"/>
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource PrimaryButton}" Tag="&#x2714;" Command="{Binding ApplyToVgsCommand}"
                      Content="{x:Static res:Resources.Planner_Apply}" ToolTip="{Binding ApplyTip}"/>
              <Button Style="{StaticResource BarButton}" Tag="&#x2611;" Command="{Binding VerifySaveCommand}"
                      Content="{x:Static res:Resources.Planner_Verify}"
                      ToolTip="{x:Static res:Resources.Planner_VerifyTip}"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <!-- Exportar -->
        <Border Style="{StaticResource Group}" DockPanel.Dock="Left">
          <DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupLabel}" Text="{x:Static res:Resources.Planner_GroupExport}"/>
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource BarButton}" Tag="&#x1F4C4;" Command="{Binding ExportExcelCommand}" Content="{x:Static res:Resources.Planner_ExportExcel}"
                      ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ExportExcelTip}"/>
              <Button Style="{StaticResource BarButton}" Tag="&#x1F5A8;" Command="{Binding ExportPdfCommand}" Content="{x:Static res:Resources.Planner_ExportPdf}"
                      ToolTip="{x:Static res:Resources.Planner_ExportPdfTip}"/>
              <Button Style="{StaticResource BarButton}" Tag="&#x2197;" Command="{Binding ExportStandaloneCommand}" Content="{x:Static res:Resources.Planner_ExportStandalone}"
                      ToolTip="{x:Static res:Resources.Planner_ExportStandaloneTip}"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <!-- Vista -->
        <Border Style="{StaticResource Group}" DockPanel.Dock="Left" BorderThickness="0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupLabel}" Text="{x:Static res:Resources.Planner_GroupView}"/>
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <CheckBox Grid.Row="0" Grid.Column="0" Margin="4,2,10,2" IsChecked="{Binding ShowPrecedences}" Content="{x:Static res:Resources.Planner_ViewPrecedences}"/>
              <CheckBox Grid.Row="0" Grid.Column="1" Margin="4,2" IsChecked="{Binding ShowCompleted}" Content="{x:Static res:Resources.Planner_ViewCompleted}"/>
              <CheckBox Grid.Row="1" Grid.Column="0" Margin="4,2,10,2" IsChecked="{Binding ShowResources}" Content="{x:Static res:Resources.Planner_ViewResources}"
                        IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static res:Resources.Planner_ComingSoonTip}"/>
              <CheckBox Grid.Row="1" Grid.Column="1" Margin="4,2" IsChecked="{Binding ShowCapacityPanel}" Content="{x:Static res:Resources.Planner_ViewCapacity}"/>
            </Grid>
          </DockPanel>
        </Border>
        <!-- Resumen (right) -->
        <Border Style="{StaticResource Group}" DockPanel.Dock="Right" BorderThickness="1,0,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupLabel}" Text="{x:Static res:Resources.Planner_GroupSummary}"/>
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Kpi}">
                <TextBlock><Run Text="{Binding ActivityCount, Mode=OneWay}" FontWeight="Bold"/> <Run Text="{x:Static res:Resources.Planner_KpiActivities}"/></TextBlock>
              </Border>
              <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Kpi}">
                <TextBlock><Run Text="{Binding PendingCount, Mode=OneWay}" FontWeight="Bold"/> <Run Text="{x:Static res:Resources.Planner_KpiPending}"/></TextBlock>
              </Border>
              <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource KpiChanged}" Tag="{Binding MovedCount}">
                <TextBlock><Run Text="{Binding MovedCount, Mode=OneWay}" FontWeight="Bold"/> <Run Text="{x:Static res:Resources.Planner_KpiMoved}"/></TextBlock>
              </Border>
              <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource KpiChanged}" Tag="{Binding CascadeCount}">
                <TextBlock><Run Text="{Binding CascadeCount, Mode=OneWay}" FontWeight="Bold"/> <Run Text="{x:Static res:Resources.Planner_KpiCascade}"/></TextBlock>
              </Border>
            </Grid>
          </DockPanel>
        </Border>
      </DockPanel>
    </Border>

    <!-- 2. Filter strip ========================================================================================= -->
    <Border Grid.Row="1" Background="{StaticResource Strip}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
            Padding="12,5">
      <DockPanel>
        <Grid DockPanel.Dock="Right" Width="120" VerticalAlignment="Center" Margin="8,0,0,0">
          <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="2,1"/>
          <TextBlock Text="{x:Static res:Resources.Planner_Search}" Foreground="{StaticResource Muted}" Margin="5,0,0,0"
                     VerticalAlignment="Center" IsHitTestVisible="False"
                     Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisible}}"/>
        </Grid>
        <!-- One strip, as in the mockup; on a narrow document the right end is clipped (search stays visible). -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
          <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center"
                      ToolTipService.ShowOnDisabled="True" ToolTip="{Binding RangeTip, Converter={StaticResource EmptyToNull}}">
            <TextBlock Style="{StaticResource FilterLabel}" Text="{x:Static res:Resources.Planner_Range}"/>
            <DatePicker SelectedDate="{Binding RangeStart}" Width="104" Language="es-MX" IsEnabled="{Binding CanEditRange}"/>
            <TextBlock Text="–" Margin="4,0" VerticalAlignment="Center"/>
            <DatePicker SelectedDate="{Binding RangeEnd}" Width="104" Language="es-MX" IsEnabled="{Binding CanEditRange}"/>
            <TextBlock Style="{StaticResource FilterLabel}" Margin="6,0,0,0">
              <Run Text="{Binding RangeDays, Mode=OneWay}"/> <Run Text="{x:Static res:Resources.Planner_Days}"/>
            </TextBlock>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding ActivityTypes}" Margin="0,0,10,0" VerticalAlignment="Center"
                        ToolTip="{x:Static res:Resources.Planner_ChipsTip}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsVisible, Mode=OneWay}" CommandParameter="{Binding Type}"
                              Command="{Binding DataContext.ToggleTypeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource FilterLabel}" Text="{x:Static res:Resources.Planner_GroupBy}"/>
            <ComboBox ItemsSource="{Binding GroupByOptions}" SelectedItem="{Binding GroupBy}" MinWidth="120"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource FilterLabel}" Text="{x:Static res:Resources.Planner_SortBy}"/>
            <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" MinWidth="90"/>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 3. Main area: centre | splitter | side panel ============================================================ -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="400"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="300" MinWidth="220"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" x:Name="CenterGrid">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="120"/>
          <RowDefinition x:Name="SplitterRow" Height="6"/>
          <RowDefinition x:Name="BottomRow" Height="190"/>
        </Grid.RowDefinitions>

        <!-- Timeline (StpTimeline): rows, day blocks and links from PlannerTimelineModel; selection two-way with the side panel -->
        <Border Grid.Row="0" Background="{StaticResource Panel}">
          <Grid>
            <!-- Edit requests (drag, Ctrl+arrows, Ctrl+Z/Y, block menu) go to Editor in PlannerContent.xaml.cs -->
            <t:TimelineView x:Name="Timeline" Model="{Binding Timeline}" SelectedKey="{Binding SelectedKey, Mode=TwoWay}"
                            ShowLinks="{Binding ShowPrecedences}" ShowCompleted="{Binding ShowCompleted}"
                            IsEditable="{Binding Editor.IsEditable}"/>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="12" CornerRadius="4"
                    Background="{StaticResource Strip}"
                    Visibility="{Binding Timeline, Converter={StaticResource EmptyToVisible}}">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{x:Static res:Resources.Planner_TimelinePlaceholder}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Static res:Resources.Planner_TimelinePlaceholderHint}" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <GridSplitter Grid.Row="1" x:Name="BottomSplitter" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{StaticResource Line}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      ToolTip="{x:Static res:Resources.Planner_SplitterTip}"/>

        <!-- Bottom panel -->
        <TabControl Grid.Row="2" x:Name="BottomTabs" Background="{StaticResource Panel}" BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource Line}" Padding="0">
          <TabItem Header="{x:Static res:Resources.Planner_TabCapacity}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <!-- left: type + goal -->
              <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,2,0">
                <StackPanel>
                  <Border Height="26" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="8,0">
                    <DockPanel VerticalAlignment="Center">
                      <TextBlock DockPanel.Dock="Right" Text="{x:Static res:Resources.Planner_CapGoal}" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                      <TextBlock Text="{x:Static res:Resources.Planner_CapDaily}" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                    </DockPanel>
                  </Border>
                  <ItemsControl ItemsSource="{Binding CapacityRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Height="26" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="8,0">
                          <DockPanel VerticalAlignment="Center">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ObjectiveText}" Foreground="{StaticResource Muted}"/>
                            <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Color}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Type}"/>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <!-- right: one column per day -->
              <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding CapacityDays}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border x:Name="C" Width="44" Height="26" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,1,1">
                          <TextBlock Text="{Binding DayOfMonth}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                            <Setter TargetName="C" Property="Background" Value="{StaticResource Weekend}"/>
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding CapacityRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ItemsControl ItemsSource="{Binding Cells}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border x:Name="C" Width="44" Height="26" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,1,1">
                                <TextBlock x:Name="T" Text="{Binding Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                  <Setter TargetName="C" Property="Background" Value="{StaticResource Weekend}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                  <Setter TargetName="T" Property="Foreground" Value="{StaticResource Muted}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOver}" Value="True">
                                  <Setter TargetName="C" Property="Background" Value="#FDECEA"/>
                                  <Setter TargetName="T" Property="Foreground" Value="#B42318"/>
                                  <Setter TargetName="T" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                              </DataTemplate.Triggers>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Grid>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="{x:Static res:Resources.Planner_TabReports}">
            <TextBlock Text="{x:Static res:Resources.Planner_ComingSoon}" Foreground="{StaticResource Muted}" Margin="12"/>
          </TabItem>
          <TabItem Header="{x:Static res:Resources.Planner_TabCharts}">
            <TextBlock Text="{x:Static res:Resources.Planner_ComingSoon}" Foreground="{StaticResource Muted}" Margin="12"/>
          </TabItem>
          <TabItem Header="{x:Static res:Resources.Planner_TabActuals}">
            <TextBlock Text="{x:Static res:Resources.Planner_ComingSoon}" Foreground="{StaticResource Muted}" Margin="12"/>
          </TabItem>
        </TabControl>
      </Grid>

      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Line}"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

      <!-- 4. Side panel ======================================================================================== -->
      <ScrollViewer Grid.Column="2" Background="{StaticResource Panel}" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource SideHeader}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Selected.Id}" Foreground="{StaticResource Muted}"/>
              <TextBlock Text="{x:Static res:Resources.Planner_Selected}" FontWeight="SemiBold"/>
            </DockPanel>
          </Border>
          <TextBlock Text="{x:Static res:Resources.Planner_NoSelection}" Foreground="{StaticResource Muted}" Margin="12,10"
                     Visibility="{Binding Selected, Converter={StaticResource EmptyToVisible}}"/>
          <Border Padding="12,10" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" DataContext="{Binding Selected}"
                  Visibility="{Binding Converter={StaticResource EmptyToVisible}, ConverterParameter=invert}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Style="{StaticResource Key}" Text="{x:Static res:Resources.Planner_SelName}"/>
              <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Val}" Text="{Binding Name}"/>
              <TextBlock Grid.Row="1" Style="{StaticResource Key}" Text="{x:Static res:Resources.Planner_SelType}"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Val}" Text="{Binding Type}"/>
              <TextBlock Grid.Row="2" Style="{StaticResource Key}" Text="{x:Static res:Resources.Planner_SelStart}"/>
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBlock Style="{StaticResource Val}" Text="{Binding StartText}"/>
                <Border Style="{StaticResource Pill}" Background="#FFF7EC" Margin="6,1,0,1" VerticalAlignment="Center"
                        Visibility="{Binding ShiftText, Converter={StaticResource EmptyToVisible}, ConverterParameter=invert}">
                  <TextBlock Text="{Binding ShiftText}" Foreground="{StaticResource Warn}"/>
                </Border>
              </StackPanel>
              <TextBlock Grid.Row="3" Style="{StaticResource Key}" Text="{x:Static res:Resources.Planner_SelFinish}"/>
              <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Val}" Text="{Binding FinishText}"/>
              <TextBlock Grid.Row="4" Style="{StaticResource Key}" Text="{x:Static res:Resources.Planner_SelQuantity}"/>
              <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Val}" Text="{Binding QuantityText}"/>
              <TextBlock Grid.Row="5" Style="{StaticResource Key}" Text="{x:Static res:Resources.Planner_SelResource}"/>
              <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,2" ItemsSource="{Binding ResourceOptions}" SelectedItem="{Binding Resource}"/>
              <TextBlock Grid.Row="6" Style="{StaticResource Key}" Text="{x:Static res:Resources.Planner_SelPredecessors}"/>
              <ItemsControl Grid.Row="6" Grid.Column="1" Margin="0,2" ItemsSource="{Binding Predecessors}"
                            ItemTemplate="{StaticResource PillTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}"/>
              <TextBlock Grid.Row="7" Style="{StaticResource Key}" Text="{x:Static res:Resources.Planner_SelSuccessors}"/>
              <ItemsControl Grid.Row="7" Grid.Column="1" Margin="0,2" ItemsSource="{Binding Successors}"
                            ItemTemplate="{StaticResource PillTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}"/>
              <TextBlock Grid.Row="8" Style="{StaticResource Key}" Text="{x:Static res:Resources.Planner_SelState}" VerticalAlignment="Top"/>
              <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource Val}" Text="{Binding StateText}"/>
            </Grid>
          </Border>

          <Border Style="{StaticResource SideHeader}">
            <TextBlock Text="{x:Static res:Resources.Planner_Config}" FontWeight="SemiBold"/>
          </Border>
          <ItemsControl ItemsSource="{Binding ConfigSections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="8,4">
                  <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpanded}" ExpandDirection="Down">
                    <ContentPresenter Margin="20,4,0,4"
                                      Content="{Binding Content, TargetNullValue={x:Static res:Resources.Planner_ComingSoon}}"/>
                  </Expander>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{x:Static res:Resources.Planner_ConfigNote}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                     Margin="12,10"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- 5. Status bar =========================================================================================== -->
    <Border Grid.Row="3" Background="#DFE3E8" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,3">
      <DockPanel TextBlock.Foreground="#3D4852">
        <TextBlock DockPanel.Dock="Right" Text="{Binding TotalsText}"/>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding SnapshotText}" Margin="0,0,18,0"/>
          <TextBlock Text="{Binding PolicyText}" Margin="0,0,18,0"/>
          <TextBlock Text="{Binding PendingChangesText}" Foreground="{StaticResource Warn}" FontWeight="SemiBold" Margin="0,0,18,0"/>
          <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage, Converter={StaticResource EmptyToNull}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
