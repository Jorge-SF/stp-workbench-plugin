<Project Sdk="Microsoft.NET.Sdk">
  <!-- Planner screen adapter tests, without WPF windows or the Workbench runtime: the timeline adapter
       (PlannerSession -> ITimelineModel) and the design data are compiled here from StpClient's sources, and run over a
       real PlannerSession. Plus StpPlanner's shared MVVM helpers and type palette. -->
  <Import Project="..\..\WorkbenchRuntime.props" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Maptek.Vulcan.Stp.Client.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\StpPlanner\StpPlanner.csproj" />
    <ProjectReference Include="..\StpTimeline\StpTimeline.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- StpClient itself needs the Workbench runtime; these two files are plain WPF/StpPlanner code. -->
    <Compile Include="..\StpClient\Views\Planner\PlannerTimelineModel.cs" Link="Linked\PlannerTimelineModel.cs" />
    <Compile Include="..\StpClient\Views\Planner\DesignSnapshot.cs" Link="Linked\DesignSnapshot.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- StpPlanner/StpBridge do not copy Newtonsoft (the Workbench provides it); the test host needs a copy. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(WorkbenchRuntime)\SDK\Third\Newtonsoft.Json\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
